    {
      "name": "2. Seguimiento de la saga",
      "description": "El paso 1 tarda 1-3 segundos en llegar a un paso terminal (COMPLETADA o COMPENSADA). Si un test de esta carpeta falla porque el paso todavia no es terminal, espera un segundo y vuelve a correr la misma request -- no hace falta repetir el paso 1.",
      "item": [
        {
          "name": "GET /sagas/por-id/:idSaga - CON cobertura",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.siniestro_id) { pm.collectionVariables.set('idSiniestroConCobertura', json.siniestro_id); }",
                  "pm.test('llego a paso terminal (si dice PENDIENTE/INICIADA/... todavia no, reintenta)', () => {",
                  "  pm.expect(['COMPLETADA', 'COMPENSADA']).to.include(json.paso_actual);",
                  "});",
                  "pm.test('quedo COMPLETADA con proveedor', () => {",
                  "  pm.expect(json.paso_actual).to.eql('COMPLETADA');",
                  "  pm.expect(json.estado).to.eql('OK');",
                  "  pm.expect(json.proveedor_id).to.not.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{orquestador}}/sagas/por-id/{{idSagaConCobertura}}",
              "host": [
                "{{orquestador}}"
              ],
              "path": [
                "sagas",
                "por-id",
                "{{idSagaConCobertura}}"
              ]
            }
          }
        },
        {
          "name": "GET /sagas/por-id/:idSaga - SIN cobertura",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.siniestro_id) { pm.collectionVariables.set('idSiniestroSinCobertura', json.siniestro_id); }",
                  "pm.test('quedo COMPENSADA por falta de proveedor', () => {",
                  "  pm.expect(json.paso_actual).to.eql('COMPENSADA');",
                  "  pm.expect(json.estado).to.eql('FALLIDO');",
                  "  pm.expect(json.motivo_fallo).to.include('proveedor');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{orquestador}}/sagas/por-id/{{idSagaSinCobertura}}",
              "host": [
                "{{orquestador}}"
              ],
              "path": [
                "sagas",
                "por-id",
                "{{idSagaSinCobertura}}"
              ]
            }
          }
        },
        {
          "name": "GET /siniestros/:id/estado (mismo dato, vía BFF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('coincide con la consulta directa al orquestador', () => {",
                  "  pm.expect(pm.response.json().paso_actual).to.eql('COMPLETADA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{bff}}/siniestros/{{idSiniestroConCobertura}}/estado",
              "host": [
                "{{bff}}"
              ],
              "path": [
                "siniestros",
                "{{idSiniestroConCobertura}}",
                "estado"
              ]
            },
            "description": "Prueba que el BFF es una puerta real hacia el Saga Log del orquestador, no una copia."
          }
        }
      ]
    },
