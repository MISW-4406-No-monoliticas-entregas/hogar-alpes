              "mode": "raw",
              "raw": "{\n  \"partner_id\": \"{{partnerId}}\"\n}"
            },
            "url": {
              "raw": "{{orquestador}}/sagas",
              "host": [
                "{{orquestador}}"
              ],
              "path": [
                "sagas"
              ]
            }
          }
        }
