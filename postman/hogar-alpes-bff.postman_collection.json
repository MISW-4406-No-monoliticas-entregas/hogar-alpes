    {
      "name": "2. Detalle del siniestro (BFF -> S2)",
      "description": "Proyeccion estado_siniestro de S2. S9 no devuelve el id_siniestro, asi que se ubica por poliza en el listado (si no aparece aun, reintentar en un segundo).",
      "item": [
        {
          "name": "GET /partners/seguros-alpes/siniestros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8004/partners/seguros-alpes/siniestros",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8004",
              "path": [
                "partners",
                "seguros-alpes",
                "siniestros"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const mio = pm.response.json().find(f => f.poliza === pm.collectionVariables.get('poliza'));",
                  "if (mio) pm.collectionVariables.set('idSiniestro', mio.id_siniestro);",
                  "pm.test('el siniestro ya esta en S2', () => pm.expect(mio, 'todavia no esta -- reintenta en un segundo').to.exist);"
                ]
              }
            }
          ]
        },
