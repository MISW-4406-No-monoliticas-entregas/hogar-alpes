{
  "info": {
    "name": "Hogar de los Alpes - BFF (local)",
    "description": "Endpoints del BFF (src/bff) contra el docker compose local: http://localhost:8004. Cada request le pega SOLO al BFF; el BFF es el que llama por HTTP al servicio interno que corresponde (S9 para registrar, S2 detalle, S4 orquestador estado de la transaccion, S10 reglas, S7 proveedores). Correr las carpetas en orden: el registro genera una poliza unica y el listado del partner captura el idSiniestro que usan los pasos siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "poliza",
      "value": ""
    },
    {
      "key": "idSincronizacion",
      "value": ""
    },
    {
      "key": "idSiniestro",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Salud",
      "description": "Salud del BFF y de sus dependencias (S9, S2, S10, S7 y S4).",
      "item": [
        {
          "name": "GET /salud",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8004/salud",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8004",
              "path": [
                "salud"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /salud/dependencias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8004/salud/dependencias",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8004",
              "path": [
                "salud",
                "dependencias"
              ]
            },
            "description": "S4 Orquestador aparece como no_integrado mientras ORQUESTADOR_URL este vacia."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "['S9 Integraciones','S2 Siniestros','S10 Reglas','S7 Matching'].forEach(s => pm.test(s + ' ok', () => pm.expect(r[s].estado).to.eql('ok')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Registrar siniestro (BFF -> S9)",
      "description": "POST /siniestros reenvia el payload del partner a S9 (POST /partners/<partner_id>/siniestros). S9 publica RegistrarSiniestro en comandos.siniestros.",
      "item": [
        {
          "name": "POST /siniestros (seguros-alpes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8004/siniestros",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8004",
              "path": [
                "siniestros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_id\": \"seguros-alpes\",\n  \"siniestro\": {\n    \"numeroReclamo\": \"SA-{{poliza}}\",\n    \"poliza\": \"{{poliza}}\",\n    \"montoEstimado\": 500000,\n    \"moneda\": \"COP\",\n    \"direccion\": {\"calle\": \"Cra 7 # 1-2\", \"ciudad\": \"Bogota\", \"pais\": \"CO\"}\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('poliza', 'POL-BFF-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Aceptado', () => pm.response.to.have.status(202));",
                  "const j = pm.response.json();",
                  "pm.test('estado PUBLICADA', () => pm.expect(j.estado).to.eql('PUBLICADA'));",
                  "if (j.id_sincronizacion) pm.collectionVariables.set('idSincronizacion', j.id_sincronizacion);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /siniestros (banco-andes, otro formato)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8004/siniestros",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8004",
              "path": [
                "siniestros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_id\": \"banco-andes\",\n  \"siniestro\": {\n    \"ref\": \"BA-{{$timestamp}}\",\n    \"policy_number\": \"POL-BA-{{$timestamp}}\",\n    \"amount\": {\"value\": 1200000, \"currency\": \"COP\"},\n    \"address\": \"Calle 1 # 2-3, Bogota, CO\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Aceptado', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /siniestros duplicado -> 409",
          "request": {
