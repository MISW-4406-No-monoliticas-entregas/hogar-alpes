          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('PUBLICADA', () => pm.expect(pm.response.json().estado).to.eql('PUBLICADA'));"
                ]
              }
            }
          ]
        }
      ]
