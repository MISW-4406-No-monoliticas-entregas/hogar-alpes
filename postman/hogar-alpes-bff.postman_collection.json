            "url": {
              "raw": "http://localhost:8004/siniestros",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8004",
              "path": [
                "siniestros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_id\": \"seguros-alpes\",\n  \"siniestro\": {\n    \"numeroReclamo\": \"SA-{{poliza}}\",\n    \"poliza\": \"{{poliza}}\",\n    \"montoEstimado\": 500000,\n    \"moneda\": \"COP\",\n    \"direccion\": {\"calle\": \"Cra 7 # 1-2\", \"ciudad\": \"Bogota\", \"pais\": \"CO\"}\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 duplicado (idempotencia de S9)', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /siniestros cuerpo invalido -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
