          ]
        },
        {
          "name": "GET /sincronizaciones/<id>",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8004/sincronizaciones/{{idSincronizacion}}",
              "protocol": "http",
              "host": [
                "localhost"
